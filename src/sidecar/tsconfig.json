{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "../../electron/dist/sidecar-build",
    "rootDir": "../..",
    "noEmit": false,
    "jsx": "react",
    "moduleResolution": "node",
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": ["server.ts"],
  "exclude": ["../../node_modules"]
}
