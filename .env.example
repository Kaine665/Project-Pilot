# ProjectPilot 环境变量
# 复制此文件为 .env.local 并填入实际值

# 数据存储目录（可选，默认 ~/.project-pilot/）
# PROJECT_PILOT_DATA_DIR=

# Claude CLI 路径（可选，默认从 PATH 查找）
# CLAUDE_CLI_PATH=

# 仅跑 Vite、Hono 另开端口时，浏览器直连 API（默认留空则用同源 /api，依赖 Vite 代理）
# 使用 Google 账号登录时建议留空，以便会话 Cookie 与 /api 同源（否则需全局 fetch credentials:include）
# VITE_API_ORIGIN=http://127.0.0.1:4500

# ── Google 账号登录（可选）：登录后数据写入 ~/.project-pilot/accounts/<google_sub>/
# Google Cloud Console → OAuth 2.0 Client（Web），授权重定向 URI 须与下方一致
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:4500/api/auth/google/callback
# 用于签发 HttpOnly 会话 Cookie（至少 16 字符随机串）
# PROJECT_PILOT_JWT_SECRET=
# OAuth 完成后浏览器跳转的前端地址（默认 http://127.0.0.1:4000）
# PROJECT_PILOT_PUBLIC_ORIGIN=http://127.0.0.1:4000
