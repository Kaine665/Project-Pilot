# ProjectPilot 环境变量
# 复制此文件为 .env.local 并填入实际值

# 数据存储目录（可选，默认 ~/.project-pilot/）
# PROJECT_PILOT_DATA_DIR=

# Claude CLI 路径（可选，默认从 PATH 查找）
# CLAUDE_CLI_PATH=

# 仅跑 Vite、Hono 另开端口时，浏览器直连 API（默认留空则用同源 /api，依赖 Vite 代理）
# VITE_API_ORIGIN=http://127.0.0.1:4500

# ── Google 登录 + Drive appData 同步 AI 凭据（可选）──
# 在 Google Cloud Console 创建 OAuth 2.0（桌面或 Web），启用 Google Drive API，重定向 URI 须与下方一致。
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# 默认与本地 Hono 一致：http://127.0.0.1:4500/api/auth/google/callback
# GOOGLE_REDIRECT_URI=http://127.0.0.1:4500/api/auth/google/callback
# OAuth 完成后跳回前端的 origin（Electron / 开发服多为 4000）
# PP_FRONTEND_ORIGIN=http://127.0.0.1:4000
# 会话 Cookie JWT 签名密钥（生产环境务必设置长随机串）
# PP_SESSION_SECRET=
# CORS 允许列表（逗号分隔）；未设置时包含常见本机开发端口，打包版若端口不同请追加。
# PP_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:8080
