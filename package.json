{
  "name": "project-pilot",
  "version": "0.1.0",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev --port 4000 --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "mcp": "tsx mcp-server/index.ts",
    "demo:load": "node scripts/load-demo-data.js",
    "demo:load-en": "node scripts/load-demo-data.js en",
    "migrate:data": "node scripts/migrate-data.js",
    "electron:dev": "concurrently --kill-others \"npm run dev\" \"wait-on http://127.0.0.1:4000 && cross-env ELECTRON_DEV=1 electron .\"",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:build": "cross-env NODE_ENV=production BUILD_TARGET=electron next build && npm run electron:compile && electron-builder --win",
    "electron:start": "electron ."
  },
  "build": {
    "appId": "com.projectpilot.app",
    "productName": "ProjectPilot",
    "directories": {
      "output": "build"
    },
    "files": [
      "electron/dist/**/*",
      "electron/splash.html"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static"
      },
      {
        "from": "public",
        "to": "standalone/public"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "node-cron": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.58.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.4"
  }
}
