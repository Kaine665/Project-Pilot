{
  "name": "project-pilot",
  "version": "0.1.5",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "postinstall": "node scripts/ensure-postcss-alloc-lru.mjs",
    "dev": "node scripts/dev-web.mjs",
    "dev:client": "vite",
    "dev:server": "cross-env NODE_ENV=development bun ./src/server/index.ts",
    "build": "vite build && bun build src/server/index.ts --outfile=dist/server/index.js --target=node --minify --external unzipper && node scripts/copy-builtin-prompt-seeds.mjs",
    "build:client": "vite build",
    "build:server": "bun build src/server/index.ts --outfile=dist/server/index.js --target=node --minify --external unzipper && node scripts/copy-builtin-prompt-seeds.mjs",
    "lint": "eslint",
    "mcp": "tsx mcp-server/index.ts",
    "demo:load": "node scripts/load-demo-data.js",
    "demo:load-en": "node scripts/load-demo-data.js en",
    "migrate:data": "node scripts/migrate-data.js",
    "migrate:layout": "tsx scripts/run-layout-migrations.ts",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:build": "cross-env NODE_ENV=production npm run build && npm run electron:compile && electron-builder --win --publish never",
    "electron:build:win": "cross-env NODE_ENV=production npm run build && npm run electron:compile && electron-builder --win --publish never",
    "electron:build:mac": "cross-env NODE_ENV=production npm run build && npm run electron:compile && electron-builder --mac --publish never",
    "release:desktop:bump": "node scripts/bump-desktop-release.mjs",
    "gen:dev-community": "node scripts/gen-community-dev-bulk.mjs",
    "patch:community-skills-sources": "node scripts/patch-community-skills-sources.mjs",
    "check:env": "node scripts/check-env.js",
    "test:provider-smoke": "bun scripts/provider-availability-smoke.ts",
    "clean:desktop": "node scripts/clean-desktop-artifacts.js",
    "prepare:desktop-bundle": "node scripts/prepare-desktop-bundle.js",
    "preelectron:start": "npm run electron:compile",
    "electron:start": "electron .",
    "site:dev": "npm run dev --prefix public-site",
    "site:build": "npm run build --prefix public-site",
    "site:preview": "npm run preview --prefix public-site"
  },
  "build": {
    "appId": "com.projectpilot.app",
    "productName": "ProjectPilot",
    "publish": null,
    "directories": {
      "output": "build"
    },
    "files": [
      "electron/dist/**/*",
      "electron/splash.html",
      "dist/**/*",
      "config/dev-server.json",
      "config/load-dev-server.cjs"
    ],
    "asarUnpack": [
      "dist/server/**/*",
      "dist/client/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/openai": "^1.3.24",
    "@alloc/quick-lru": "^5.2.0",
    "@anthropic-ai/claude-agent-sdk": "^0.2.79",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@hono/node-server": "^1.19.11",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@openai/codex": "^0.114.0",
    "@openai/codex-sdk": "^0.114.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "ai": "^4.3.19",
    "archiver": "^7.0.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.9",
    "i18next": "^25.10.9",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.563.0",
    "node-cron": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.6.6",
    "react-markdown": "^10.1.0",
    "react-router": "^7.13.2",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.4.0",
    "undici": "^8.0.2",
    "unzipper": "^0.12.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^7.0.0",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "eslint": "^9",
    "playwright": "^1.58.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.2",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "@alloc/quick-lru": "^5.2.0"
  }
}
