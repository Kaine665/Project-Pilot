# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# 本地桌面 / 发布试验输出目录（勿提交）
/build-electron-latest/
/build-next-release/
/build-pp-release/
/build-pp-v4/

# misc
.mcp-stdin-null
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# runtime data (legacy, when data was stored in project dir)
/data/

# Claude Code settings
/.claude/

# MCP config (contains secrets)
.mcp.json

# messages and debug
/messages/

# external projects
/elapp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
openclaw/

# SuperDesign artifacts
.superdesign/

# 项目文档：`docs/` 纳入版本控制；请勿在此添加忽略整个 `docs/` 目录的规则。

# 第三方技能完整仓库应放在 ~/.project-pilot/skills/_vendor/ ，勿提交仓库内拷贝
# 本地临时目录（截图、试验脚本、导入缓存等）
/tmp/

# 与主仓库无关的侧项目（各自独立 Git 仓库；勿提交进 ProjectPilot）
/external/

# 本地连接测试 JSON（可能含明文 API 密钥，绝不可提交）
.tmp-test-conn.json

# 本地 API 密钥测试文件（含明文密钥，绝不可提交）
.api-test-keys.mjs
