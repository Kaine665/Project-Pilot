{
  "mcpServers": {
    "project-pilot": {
      "command": "node",
      "args": [
        "node_modules/tsx/dist/cli.mjs",
        "mcp-server/index.ts"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "TSX_TSCONFIG_PATH": "tsconfig.json"
      }
    },
    "paper": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "http://127.0.0.1:29979/mcp"]
    }
  }
}
