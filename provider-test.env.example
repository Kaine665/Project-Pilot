# =============================================================================
# ProjectPilot — provider-test.env（本地专用）
# =============================================================================
# 复制本文件为项目根目录下的 provider-test.env，填入测试用 Key。
# provider-test.env 已写入 .gitignore，不会被 git 跟踪。
#
# 变量约定：PP_PROVIDER_TEST_<PROVIDER>，PROVIDER 为内置 ProviderId 的大写
# 形式（与 BUILT_IN_PROVIDER_IDS 对齐）。脚本或未来测试可 dotenv 读取。
#
# 切勿把填好的 provider-test.env 提交或粘贴到聊天 / PR。
#
# CI：在 GitHub 仓库 Actions Secrets 里配置同名变量（如 PP_PROVIDER_TEST_MINIMAX），
# 变更 aggregate-models-live / settings 探测 / providers-registry 等路径时会跑
# `npm run test:provider-smoke`（真实请求）。Fork PR 不会执行该 workflow。
# =============================================================================

# ----- 原厂 -----
PP_PROVIDER_TEST_ANTHROPIC=
PP_PROVIDER_TEST_OPENAI=

# ----- 第三方（API Key）-----
PP_PROVIDER_TEST_DEEPSEEK=
PP_PROVIDER_TEST_QWEN=
PP_PROVIDER_TEST_ZHIPU=
PP_PROVIDER_TEST_MINIMAX=
PP_PROVIDER_TEST_KIMI=
PP_PROVIDER_TEST_MOONSHOT=
PP_PROVIDER_TEST_SILICONFLOW=
PP_PROVIDER_TEST_ZENMUX=
PP_PROVIDER_TEST_VOLCENGINE=
PP_PROVIDER_TEST_ARKCODING=
PP_PROVIDER_TEST_OPENROUTER=

# ----- Ollama（无 Key；填可访问的根地址，如 http://127.0.0.1:11434）-----
PP_PROVIDER_TEST_OLLAMA_BASE_URL=

# ----- 内置 custom 槽（若仍使用 registry 中 id 为 custom 的预设）-----
PP_PROVIDER_TEST_CUSTOM=

# ----- 可选：仅调试时覆盖某供应商 Base URL（多数情况留空）-----
# PP_PROVIDER_TEST_MINIMAX_BASE_URL=
# PP_PROVIDER_TEST_QWEN_BASE_URL=
